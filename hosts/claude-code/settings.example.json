{
  "_comment": "Optional guard rails for a gateway data-dir checkout. Merge into .claude/settings.json (project) after `install.sh --host claude-code --hook`.",
  "permissions": {
    "deny": [
      "Write(config/resources/**)",
      "Edit(config/resources/**)",
      "Write(projects/**)",
      "Edit(projects/**)"
    ],
    "allow": [
      "Bash(ign *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/block_ignition_disk_writes.py" }
        ]
      }
    ]
  }
}
