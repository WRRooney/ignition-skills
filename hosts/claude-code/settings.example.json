{
  "_comment": "What `guardrails.py on --host claude-code` adds to .claude/settings.json; merge by hand if you prefer.",
  "permissions": {
    "deny": [
      "Write(config/resources/**)",
      "Edit(config/resources/**)",
      "Write(projects/**)",
      "Edit(projects/**)"
    ],
    "allow": [
      "Bash(ign *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/block_ignition_disk_writes.py" }
        ]
      }
    ]
  }
}
